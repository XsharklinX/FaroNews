<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 en adelante: copia en la nube y traspaso entre teléfonos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="faro-datos.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="faro-datos.json" />
    </device-transfer>
</data-extraction-rules>
